---
/**
 * Google rating, Facebook recommendations + two rows of reviews gliding in opposite directions.
 * - Pauses on hover / keyboard focus so people can read.
 * - With "reduce motion" turned on, it becomes a normal swipeable row instead.
 */
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { googleReviews, facebookReviews, reviews, reviewsUpdated } from '../data/reviews';

const { rating, count, url } = googleReviews;
const fb = facebookReviews;
const show = reviews.length > 0 && (rating !== null || fb.recommendPercent !== null);

// Alternate reviews between the two rows so Google & Facebook ones mix
const rows = reviews.length > 4 ? [reviews.filter((_, i) => i % 2 === 0), reviews.filter((_, i) => i % 2 === 1)] : [reviews];
// ~7s per card keeps it slow enough to read
const duration = (n: number) => `${Math.max(35, n * 7)}s`;
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---
{show && (
  <section id="reviews" class="grain overflow-hidden bg-soot py-12 text-parchment md:py-24">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <p class="ribbon ml-3">What people say</p>
          <h2 class="mt-4 text-4xl md:text-5xl">Loved by our members</h2>
        </div>

        <div class="grid w-full grid-cols-2 gap-3 sm:flex sm:w-auto">
          {rating !== null && (
            <a href={url} target="_blank" rel="noopener" class="group flex flex-col gap-2 border border-brass-400/40 p-4 transition-colors hover:border-brass-400 sm:flex-row sm:items-center sm:gap-4 sm:px-5">
              <span class="font-display text-5xl leading-none font-bold text-brass-300">{rating.toFixed(1)}</span>
              <span>
                <Stars rating={rating} size="size-4" class="text-brass-400" />
                <span class="mt-1 block text-xs text-parchment/70">{count} Google reviews</span>
                <span class="mt-1 flex items-center gap-1 text-[0.65rem] font-semibold tracking-wider text-brass-300 uppercase group-hover:underline">Read them <Icon name="external" size={11} /></span>
              </span>
            </a>
          )}
          {fb.recommendPercent !== null && (
            <a href={fb.url} target="_blank" rel="noopener" class="group flex flex-col gap-2 border border-brass-400/40 p-4 transition-colors hover:border-brass-400 sm:flex-row sm:items-center sm:gap-4 sm:px-5">
              <span class="font-display text-5xl leading-none font-bold text-brass-300">{fb.recommendPercent}%</span>
              <span>
                <span class="flex items-center gap-1.5 text-sm font-semibold text-parchment"><Icon name="facebook" size={15} class="text-brass-400" /> Recommend us</span>
                <span class="mt-1 block text-xs text-parchment/70">{fb.count} Facebook reviews</span>
                <span class="mt-1 flex items-center gap-1 text-[0.65rem] font-semibold tracking-wider text-brass-300 uppercase group-hover:underline">Read them <Icon name="external" size={11} /></span>
              </span>
            </a>
          )}
        </div>
      </div>
      {reviewsUpdated && <p class="mt-3 text-right text-xs text-parchment/40">Figures as of {reviewsUpdated}</p>}
    </div>

    <div class="mt-8 space-y-4 sm:mt-12 sm:space-y-6">
      {rows.map((row, i) => (
        <div class="marquee" data-reverse={i % 2 === 1 ? '' : undefined} style={`--marquee-duration: ${duration(row.length)}`}>
          <div class="marquee-track">
            {[0, 1].map((copy) => (
              <ul class:list={['marquee-group', copy === 1 && 'marquee-dup']} aria-hidden={copy === 1 ? 'true' : undefined}>
                {row.map((r) => (
                  <li class="w-[16.5rem] shrink-0 sm:w-[23rem]">
                    <figure class="flex h-full flex-col border border-white/5 border-t-brass-400 border-t-4 bg-soot-light/90 p-5 shadow-lg sm:p-6 transition-colors hover:bg-soot-light">
                      <div class="flex items-start justify-between">
                        <span class="h-6 font-display text-6xl leading-[0.9] text-brass-400" aria-hidden="true">“</span>
                        {r.stars && <Stars rating={r.stars} size="size-4" class="text-brass-400" />}
                      </div>
                      <blockquote class="mt-3 line-clamp-6 flex-1 text-[0.95rem] sm:line-clamp-none sm:text-[1.02rem] leading-relaxed text-parchment/90">{r.text}</blockquote>
                      <figcaption class="mt-5 flex items-center gap-3 border-t border-white/10 pt-4">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-banner-700 font-display text-sm text-parchment">{initials(r.name)}</span>
                        <span class="text-sm leading-tight">
                          <span class="block font-semibold text-parchment">{r.name}</span>
                          <span class="flex items-center gap-1 text-xs text-parchment/50">
                            {r.source === 'facebook' ? <><Icon name="facebook" size={11} /> Facebook review</> : <>Google review</>}
                            {r.when && ` · ${r.when}`}
                          </span>
                        </span>
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .marquee {
    --gap: 1.5rem;
    overflow: hidden;
    /* fade the edges */
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: var(--gap);
    animation: marquee var(--marquee-duration, 60s) linear infinite;
  }
  .marquee[data-reverse] .marquee-track {
    animation-direction: reverse;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  .marquee-group {
    display: flex;
    gap: var(--gap);
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - var(--gap) / 2));
    }
  }

  /* Reduced motion: no animation, swipe/scroll instead */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      mask-image: none;
      padding-inline: 1rem;
      scroll-snap-type: x mandatory;
    }
    .marquee-track {
      animation: none;
    }
    .marquee-dup {
      display: none;
    }
    .marquee li {
      scroll-snap-align: start;
    }
  }
</style>
