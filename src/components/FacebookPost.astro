---
/**
 * A Facebook post card. Every card is the same shape:
 * - fixed 4:3 image box: the full image is shown (never cropped) over a
 *   blurred copy of itself; text-only posts get a branded placeholder
 * - text clamped to a fixed number of lines, link pinned to the bottom
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { fbImage, postDate, type FbPost } from '../lib/content';

interface Props { post: FbPost; lines?: 4 | 5 | 6 }
const { post, lines = 5 } = Astro.props;
const img = fbImage(post.image);
const clamp = { 4: 'line-clamp-4', 5: 'line-clamp-5', 6: 'line-clamp-6' }[lines];
---
<article class="framed flex h-full flex-col overflow-hidden">
  <a href={post.permalink} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" class="relative block aspect-[4/3] shrink-0 overflow-hidden bg-soot">
    {img ? (
      <>
        <Image src={img} alt="" width={160} class="absolute inset-0 size-full scale-110 object-cover opacity-60 blur-xl" />
        <Image src={img} alt="" width={700} widths={[400, 700]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 85vw" class="relative size-full object-contain" />
      </>
    ) : (
      <div class="grain flex size-full flex-col items-center justify-center gap-3 bg-banner-800 p-6 text-center">
        <Icon name="facebook" size={34} class="text-brass-300" />
        <span class="font-display text-xl tracking-widest text-parchment uppercase">Club update</span>
      </div>
    )}
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="flex items-center gap-2 text-xs font-semibold tracking-wider text-banner-700 uppercase">
      <Icon name="facebook" size={14} />
      <time datetime={post.createdTime}>{postDate(post.createdTime)}</time>
    </p>
    {post.message && (
      <p class:list={['mt-2 text-[0.95rem] leading-relaxed whitespace-pre-line text-soot/85', clamp]}>{post.message}</p>
    )}
    <a href={post.permalink} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-banner-700 hover:underline">
      View on Facebook <Icon name="external" size={14} />
    </a>
  </div>
</article>
