---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <section class="container-site flex flex-col items-start py-24">
    <p class="ribbon ml-3">404</p>
    <h1 class="mt-5 text-5xl md:text-7xl">Last orders on this page</h1>
    <p class="mt-4 max-w-lg text-lg text-soot/75">We couldn't find what you were looking for. It may have moved when we rebuilt the site.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-banner">Back to home</a>
      <a href="/#whats-on" class="btn border-2 border-soot/20 hover:border-soot">What's on</a>
    </div>
  </section>
</Layout>
